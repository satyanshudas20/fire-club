<%- include('../partials/top') %>
<div class="page-head"><div><h1>Audit log</h1><p>The 200 most recent actions.</p></div></div>
<div class="card" style="padding:0"><div class="table-wrap"><table><thead><tr><th>When (UTC)</th><th>Who</th><th>Action</th><th>Detail</th></tr></thead><tbody>
<% rows.forEach(r => { %><tr><td class="nowrap"><%= r.created_at %></td><td><%= r.name || 'system' %></td><td><span class="badge mute"><%= r.action %></span></td><td><%= r.detail %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../partials/bottom') %>
