<%- include('../partials/top') %>
<a href="/members" class="muted">← All members</a>
<div class="page-head mt"><div class="row"><span class="avatar" style="width:56px;height:56px;font-size:1.2rem"><%= initials(m.name) %></span>
  <div><h1><%= m.name %> <span class="badge <%= m.status === 'active' ? '' : 'bad' %>"><%= m.status %></span></h1><p><%= m.email %> <%= m.phone ? '· ' + m.phone : '' %> · joined <%= fmtDate(m.joined_at) %></p></div></div></div>
<div class="grid g2">
  <div class="stack">
    <div class="card"><h2>Emergency & bio</h2><p><b>Emergency contact:</b> <%= m.emergency_contact || 'Not provided' %></p><p class="muted"><%= m.bio || 'No bio.' %></p></div>
    <div class="card"><h2><%- icon('shield') %> Certifications</h2>
      <% if (!certs.length) { %><div class="empty">None</div><% } %><div class="list">
      <% certs.forEach(c => { const exp = c.expires_at && c.expires_at < today; %><div class="row between"><span><%= c.title %></span><span class="badge <%= exp ? 'bad' : '' %>"><%= exp ? 'Expired ' : c.expires_at ? 'Until ' : '' %><%= c.expires_at ? fmtDate(c.expires_at) : 'No expiry' %></span></div><% }) %></div></div>
    <div class="card"><h2><%- icon('box') %> Gear out</h2><% if (!loans.length) { %><div class="empty">Nothing borrowed</div><% } %>
      <div class="list"><% loans.forEach(l => { %><div class="row between"><span><%= l.name %> ×<%= l.qty %></span><span class="badge <%= l.due_at < today ? 'bad' : 'mute' %>">Due <%= fmtDate(l.due_at) %></span></div><% }) %></div></div>
    <div class="card"><h2><%- icon('calendar') %> Event history</h2><% if (!events.length) { %><div class="empty">No RSVPs</div><% } %>
      <div class="list"><% events.forEach(e => { %><div class="row between"><span><%= e.title %><br><small><%= fmtDate(e.starts_at) %></small></span><span class="badge <%= e.checked_in ? '' : 'mute' %>"><%= e.checked_in ? 'attended' : e.status %></span></div><% }) %></div></div>
  </div>
  <div class="stack">
    <% if (isAdmin) { %>
    <form class="card" method="post" action="/members/<%= m.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Account & plan</h2>
      <div class="field"><label>Role</label><select name="role"><% ['member','officer','admin'].forEach(r => { %><option <%= m.role === r ? 'selected' : '' %>><%= r %></option><% }) %></select></div>
      <div class="field"><label>Status</label><select name="status"><% ['active','suspended'].forEach(r => { %><option <%= m.status === r ? 'selected' : '' %>><%= r %></option><% }) %></select></div>
      <div class="field"><label>Plan</label><select name="plan_id"><% plans.forEach(p => { %><option value="<%= p.id %>" <%= m.plan_id === p.id ? 'selected' : '' %>><%= p.name %> (<%= p.interval === 'free' ? 'free' : money(p.price_cents) + '/' + p.interval %>)</option><% }) %></select></div>
      <div class="field"><label>Plan renews on</label><input class="input" type="date" name="plan_renews_at" value="<%= m.plan_renews_at || '' %>"></div>
      <button class="btn">Save</button></form>
    <form class="card" method="post" action="/members/<%= m.id %>/reset-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Reset password</h2>
      <div class="field"><input class="input" name="password" minlength="8" placeholder="New temporary password" required></div><button class="btn dark">Reset</button></form>
    <% } else { %><div class="card"><h2>Plan</h2><p><b><%= m.plan_name || '—' %></b> · renews <%= fmtDate(m.plan_renews_at) %></p></div><% } %>
    <div class="card"><h2><%- icon('card') %> Payments</h2><% if (!payments.length) { %><div class="empty">None</div><% } %>
      <div class="list"><% payments.forEach(p => { %><div class="row between"><span><%= money(p.amount_cents) %> · <small><%= p.note %></small></span><span class="badge <%= p.status === 'paid' ? '' : 'bad' %>"><%= p.status %> · <%= fmtDate(p.created_at) %></span></div><% }) %></div></div>
    <% if (isAdmin && m.id !== user.id) { %><form method="post" action="/members/<%= m.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn danger" data-confirm="Permanently delete <%= m.name %> and all their records?"><%- icon('trash') %> Delete member</button></form><% } %>
  </div>
</div>
<%- include('../partials/bottom') %>
