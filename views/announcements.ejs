<%- include('partials/top') %>
<div class="page-head"><div><h1>Announcements</h1><p>News and notices from the club officers.</p></div></div>
<% if (isOfficer) { %><details class="card mb"><summary><%- icon('plus') %> Post an announcement</summary>
  <form method="post" action="/announcements" class="mt"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label>Title</label><input class="input" name="title" required maxlength="120"></div>
    <div class="field"><label>Message</label><textarea name="body" required maxlength="4000"></textarea></div>
    <div class="row between"><label class="check"><input type="checkbox" name="pinned"> Pin to top</label><button class="btn">Post</button></div></form></details><% } %>
<% if (!items.length) { %><div class="card empty">No announcements yet.</div><% } %>
<div class="stack">
<% items.forEach(a => { %><article class="card" <%- a.pinned ? 'style="border-color:var(--aqua-3)"' : '' %>>
  <div class="row between"><h2 style="margin:0"><%= a.pinned ? '📌 ' : '' %><%= a.title %></h2>
    <% if (isOfficer) { %><div class="row" style="gap:.4rem">
      <form method="post" action="/announcements/<%= a.id %>/pin"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost sm"><%= a.pinned ? 'Unpin' : 'Pin' %></button></form>
      <form method="post" action="/announcements/<%= a.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn danger sm" data-confirm="Delete this announcement?"><%- icon('trash', 14) %></button></form></div><% } %></div>
  <small><%= a.author || 'Club' %> · <%= fmtDateTime(a.created_at.replace(' ', 'T')) %></small>
  <p style="white-space:pre-wrap;margin-top:.6rem"><%= a.body %></p></article><% }) %></div>
<%- include('partials/bottom') %>
